    "Only translate strings that do not already have a value for the target language." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "value" : "Käännä vain merkkijonot, joilla ei ole vielä arvoa kohdekielelle.",
            "state" : "translated"
          }
        },
        "fr-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduis uniquement les chaînes qui n'ont pas déjà de valeur pour la langue cible."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Vertaal alleen strings die geen waarde hebben voor de taal van het doelwit.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ dịch các chuỗi mà chưa có giá trị cho ngôn ngữ đích."
          }
        },
        "ar-SA" : {
          "stringUnit" : {
            "value" : "قم فقط بترجمة السلاسل التي لا تحتوي بالفعل على قيمة للغة المستهدفة.",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Oversæt kun strenge, der ikke allerede har en værdi for målsproget.",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "แปลเฉพาะสตริงที่ยังไม่มีค่าสำหรับภาษาเป้าหมาย",
            "state" : "translated"
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne traduisez que les chaînes qui n'ont pas déjà de valeur pour la langue cible."
          }
        },
        "pl" : {
          "stringUnit" : {
            "value" : "Tylko tłumacz ciągi, które nie mają jeszcze wartości dla języka docelowego.",
            "state" : "translated"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce únicamente cadenas que no tengan ya un valor para el idioma de destino."
          }
        },
        "da-DK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversæt kun strenge, hvis de ikke allerede har en værdi i det ønskede sprog."
