        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Перевод основных языков по умолчанию, с действиями меню для существующих языков и региональных вариантов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Översätt huvudspråken som standard, med menyåtgärder för befintliga språk och regionala varianter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- แปลภาษาหลักโดยค่าเริ่มต้น พร้อมการดำเนินการเมนูสำหรับภาษาที่มีอยู่และรูปแบบภูมิภาค"
