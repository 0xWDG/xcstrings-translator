    "When enabled, existing translations are not translated again." : {
      "localizations" : {
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing translations werden, wenn sie aktiviert sind, nicht mehr übersetzt."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les traductions existantes ne sont pas rétraduites lorsqu'elles sont activées."
          }
        },
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
