    "Translate each language once instead of every regional or script variant." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaal elke taal één keer in plaats van elke regionale of scriptvariant."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Traduire chaque langue une seule fois au lieu de chaque variante régionale ou de chaque script.",
