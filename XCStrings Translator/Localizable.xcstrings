        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce solo cadenas de texto que no tengan ya un valor para el idioma de destino."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
