        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Ana dilleri varsayılan olarak çevirin, mevcut diller ve bölgesel varyantlar için menü eylemleriyle."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
