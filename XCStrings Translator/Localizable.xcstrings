        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Käännä pääkielet oletusarvoisesti, ja käytettävissä on valikkotoimintoja olemassa oleville kielille ja alueellisille varianteille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Traduire les langues principales par défaut, avec des actions de menu pour les langues existantes et les variantes régionales."
