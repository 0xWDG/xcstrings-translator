        "hi-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब सक्षम हो, तो मौजूदा अनुवादों का फिर से अनुवाद नहीं किया जाता है।"
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
